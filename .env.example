# 공유 폴더 경로 설정
# Windows + WSL 환경에서 카카오톡에 파일을 전달할 폴더입니다.
# 아래 파일을 .env로 복사한 뒤 본인 경로로 수정하세요.
#
#   cp .env.example .env
#
# WSL 경로 형식으로 입력합니다. (예: /mnt/c/Users/사용자이름/Desktop/kakao-share)
KAKAO_SHARE_DIR=/mnt/c/Users/jhkim/Desktop/kakao-share

# Wine Firefox 브라우저 포함 여부
# 기본값은 false입니다. 카카오톡만 사용할 경우 그대로 두세요.
# 브라우저까지 포함하려면 둘 다 true로 바꾼 뒤 다시 빌드하세요.
INSTALL_FIREFOX=false
ENABLE_FIREFOX=false
# 타임존 설정 (기본값: Asia/Seoul)
TZ=Asia/Seoul

# 화면 해상도 설정 (기본값: 1280x800)
# 예: 1920x1080, 1600x900, 1280x800
RESOLUTION=1280x800

# Wine DPI / UI 배율 설정 (기본값: 96)
# 일반 모니터: 96 (100%)
# 고해상도 / QHD / 4K 모니터: 120 (125%), 144 (150%), 192 (200%)
DPI=96

# VNC 접속 비밀번호 (선택 사항)
# 설정하지 않으면 비밀번호 없이 바로 접속됩니다.
# 외부 접속이나 공용 네트워크에서 사용할 경우 비밀번호를 설정하세요.
VNC_PASSWORD=
